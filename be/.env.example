APP_NAME="Sistem Peminjaman Ruang Rapat & Kendaraan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistem_peminjaman_laravel
DB_USERNAME=postgres
DB_PASSWORD=
DB_TIMEZONE=UTC
# Same VPS/localhost: disable. Remote DB: require (or verify-ca/verify-full when CA files are configured).
DB_SSLMODE=disable

FRONTEND_URL=http://localhost:5173
TRUSTED_PROXIES=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=sistem-peminjaman-barang
JWT_AUDIENCE=sistem-peminjaman-barang-api
JWT_ACCESS_TTL_SECONDS=1800
JWT_REFRESH_TTL_SECONDS=604800
JWT_REFRESH_COOKIE_SECURE=false
AUTH_INACTIVITY_TIMEOUT_MINUTES=30
AUTH_ACTIVITY_WRITE_INTERVAL_SECONDS=60
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_ACCOUNT_MAX_ATTEMPTS=15
AUTH_LOGIN_DECAY_SECONDS=60
AUTH_REFRESH_MAX_ATTEMPTS=30
AUTH_PASSWORD_MAX_ATTEMPTS=5
BOOKING_CREATE_MAX_ATTEMPTS=5
BOOKING_MAX_DURATION_DAYS=7
BOOKING_MAX_FUTURE_DAYS=180
BOOKING_MAX_ACTIVE_PER_USER_COUNT=10
# Menit setelah jam selesai pemakaian ruang sebelum sistem menutup peminjaman
# ruang secara otomatis. 0 = fitur dimatikan.
BOOKING_ROOM_AUTO_CONFIRM_MINUTES=0
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SEED_DEFAULT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Password reset email delivery.
# Development default is "log": the email is written to storage/logs/laravel.log
# and never actually sent. Set MAIL_MAILER=smtp and fill the credentials below to
# deliver real messages. Never commit real credentials — keep them in .env only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Password reset link target. Defaults to FRONTEND_URL; set explicitly when the
# SPA is served from a different origin than the API.
PASSWORD_RESET_URL=
PASSWORD_RESET_EXPIRE_MINUTES=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
